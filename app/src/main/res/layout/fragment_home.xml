<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp"
    android:baselineAligned="false">

    <!-- 좌: 약정별 남은 여유 (주행 중에도 보이는 화면) -->
    <LinearLayout
        android:layout_width="0dp" android:layout_weight="3" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@color/card" android:padding="24dp">

        <TextView android:id="@+id/txtState"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="대기 중" android:textSize="26sp" android:textColor="@color/muted" />

        <TextView android:id="@+id/txtPlan1Title"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/text" />
        <TextView android:id="@+id/txtPlan1Big"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textSize="76sp" android:textStyle="bold" android:textColor="@color/accent" />
        <TextView android:id="@+id/txtPlan1Detail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textSize="23sp" android:textColor="@color/text" />

        <TextView android:id="@+id/txtPlan2Title"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/text" />
        <TextView android:id="@+id/txtPlan2Big"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textSize="76sp" android:textStyle="bold" android:textColor="@color/accent" />
        <TextView android:id="@+id/txtPlan2Detail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textSize="23sp" android:textColor="@color/text" />

        <TextView android:id="@+id/txtNoPlan"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="등록된 약정이 없습니다.\n정차 중에 약정 탭에서 리스·장기렌트 약정거리나 보험 마일리지 구간을 등록해 주세요."
            android:textSize="28sp" android:textColor="@color/text" android:visibility="gone" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/txtTrip"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textSize="23sp" android:textColor="@color/muted" />
    </LinearLayout>

    <!-- 우: 목적지 영향 + 음성 -->
    <LinearLayout
        android:layout_width="0dp" android:layout_weight="2" android:layout_height="match_parent"
        android:orientation="vertical" android:layout_marginStart="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="이 목적지를 다녀오면" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/muted" />

        <TextView android:id="@+id/txtDest"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="내비에 목적지를 넣으면 여기에 표시됩니다." android:textSize="25sp" android:textStyle="bold" android:textColor="@color/text" />

        <TextView android:id="@+id/txtAdvice"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="" android:textSize="24sp" android:textColor="@color/text" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
            <Button android:id="@+id/btnRemain" android:layout_width="0dp" android:layout_weight="1" android:layout_height="84dp"
                android:text="남은 거리" android:textSize="24sp" />
            <Button android:id="@+id/btnPace" android:layout_width="0dp" android:layout_weight="1" android:layout_height="84dp" android:layout_marginStart="8dp"
                android:text="만기 예상" android:textSize="24sp" />
            <Button android:id="@+id/btnMic" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="84dp" android:layout_marginStart="8dp"
                android:text="🎤 묻기" android:textColor="@color/text" android:textSize="24sp" />
        </LinearLayout>

        <TextView android:id="@+id/txtVoice"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="" android:textSize="21sp" android:textColor="@color/accent" />

        <TextView android:id="@+id/txtSpoken"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="" android:textSize="22sp" android:textColor="@color/text" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/txtSignals"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="17sp" android:textColor="@color/muted" android:text="" />

        <TextView android:id="@+id/txtError"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="17sp" android:textColor="@color/warn" android:text="" />

        <Button android:id="@+id/btnStart" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="6dp"
            android:text="운행 시작 (기어를 옮기면 자동 시작)" android:textColor="@color/text" android:textSize="22sp" />

        <Button android:id="@+id/btnArrive"
            android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="6dp"
            android:text="도착 · 운행 종료" android:textSize="24sp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
