<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vehicle SDK: Odometer(약정 사용 거리), Door(운행 종료 판단), CarInfo(차대번호, 선택). 모두 normal 레벨 읽기 퍼미션 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <!-- Seat: 운전석 안전벨트 체결 상태 (신호 표시용) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- NaviHelper SDK: get*Info (목적지·현재위치·최근 목적지). 경로 요청(NAVI_ROUTE_SEARCH)은 사용하지 않는다 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- FusedLocation SDK: 내비 현재 위치가 없을 때 왕복 거리 추정에 쓰는 좌표 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- TextToSpeech / SpeechToText SDK -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 내비 화면이 앞에 있어도 목적지 이벤트를 받아 말하기 위한 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KiloPaceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KiloPace">

        <!-- AAOS 차량 API (CarUxRestrictionsManager). 없는 환경에서도 설치되도록 required=false -->
        <uses-library android:name="android.car" android:required="false" />

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="차량 신호(계기판 누적거리·내비 목적지)를 받아 약정거리 초과를 음성으로 알림" />
        </service>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <!-- 주행 중에도 Driving 화면이 가려지지 않도록 선언. 입력 UI는 앱이 CarUxRestrictions로 직접 잠근다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
